# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where ConnectMeet is hosted (used for invite links).
APP_URL="MY_APP_URL"
VITE_APP_URL=""

# LiveKit Video Conferencing (optional; falls back to built-in multi-peer WebRTC if unset)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# Resend Email Service (optional; sends real meeting invite & reminder emails when set)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="ConnectMeet <onboarding@resend.dev>"

# Note: Cloud SQL PostgreSQL connection variables (SQL_HOST, SQL_DB_NAME, SQL_USER, SQL_PASSWORD,
# SQL_ADMIN_USER, SQL_ADMIN_PASSWORD) and Firebase config (firebase-applet-config.json) are
# provisioned automatically by AI Studio.
